    "def duplicate(in_path, out_path, count):\n",
    "    with open(in_path, \"rb\") as f:\n",
    "        data = f.read()\n",
    "    \n",
    "    with open(out_path, \"wb\") as f:\n",
    "        for _ in range(count):\n",
    "            f.write(data)"
   ]
